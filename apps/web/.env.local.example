# Frontend environment variables (copy to .env.local and fill in real values)
# Never commit .env.local — it contains real credentials

# Firebase (client SDK — public values, safe as NEXT_PUBLIC_*)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to point the frontend at local Firebase emulators
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Public site URL — used for SEO metadata, sitemap and robots.txt
# Dev: http://localhost:3000  |  Prod: https://proops.com.br
NEXT_PUBLIC_SITE_URL=https://proops.com.br

# Google Search Console — paste the content attribute value from the verification meta tag
# How to get: Search Console → Add property → HTML tag → content="XXX"
NEXT_PUBLIC_SEARCH_CONSOLE_VERIFICATION=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# How to get: GA4 → Admin → Data Streams → Web → Measurement ID
NEXT_PUBLIC_GA_ID=

# WhatsApp — dois números DISTINTOS, cada um com default fixo no código
# (src/lib/whatsapp-contacts.ts). Só defina aqui para sobrescrever o default.
# Aceitam qualquer formato (parênteses, espaços, hífen, "+"); o link wa.me usa só os dígitos.
#  - SUPPORT: suporte/vendas, exibido na landing (FAB, footer, CTA).
#  - BOT: assistente, exibido no app autenticado (dock + card no perfil) para tenants com WhatsApp.
# Obs: a antiga NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER foi descontinuada — remova-a na Vercel.
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=
NEXT_PUBLIC_WHATSAPP_BOT_NUMBER=

# Billing cache cross-layer invalidation (shared with Firebase Functions)
BILLING_CACHE_INVALIDATION_SECRET=your-random-secret-here

# Cloudflare Turnstile site key (public) — bot protection on the signup form.
# Get it from the Turnstile dashboard. If unset, the widget is not rendered and
# no captcha token is sent (dev/CI). Pair with TURNSTILE_SECRET_KEY on the backend.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# LOCAL DEV ONLY: set to "true" to enable POST /api/dev/mfa-bypass (superadmin
# TOTP skip on localhost). Gated on NODE_ENV!=production + erp-softcode project.
ENABLE_DEV_MFA_BYPASS_ROUTE=

# Google Drive — seletor de pastas (Google Picker).
# As duas variaveis sao PUBLICAS por natureza (vao no HTML). O que as protege e
# a configuracao no Google Cloud, nao o segredo:
#  - o client_id e restrito pelas "Origens JavaScript autorizadas" do cliente OAuth
#  - a API key e restrita A API (so Google Picker API) e NAO por referenciador:
#    a validacao da chave roda dentro do iframe do docs.google.com, entao o
#    referenciador visto pelo Google e o dele, nunca o do nosso app. Cadastrar
#    "Sites" ali quebra o Picker com "The API developer key is invalid".
#    Restrita a Picker API a chave sozinha nao le o Drive de ninguem — toda
#    operacao real exige o token OAuth do usuario.
# Sem elas o botao "Escolher pasta no Drive" nao aparece; a conexao OAuth em si
# nao depende delas (ela usa GOOGLE_CALENDAR_CLIENT_ID/SECRET no backend).
# Pre-requisitos no Google Cloud: ativar Google Drive API e Google Picker API,
# acrescentar o escopo .../auth/drive.file e o redirect URI
# .../api/backend/v1/drive/google/callback ao cliente OAuth existente.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
