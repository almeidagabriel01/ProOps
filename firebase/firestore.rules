rules_version = '2';

/**
 * Firestore Security Rules - Multi-Tenant ERP SaaS
 *
 * SECURITY ARCHITECTURE:
 * 1. DENY BY DEFAULT: All paths not explicitly matched are denied.
 * 2. CLOUD FUNCTIONS AUTHORITY: Complex logic and critical writes (billing, quotas) MUST go through Cloud Functions.
 * 3. TENANT ISOLATION: Users can ONLY access data tagged with their `tenantId`.
 * 4. ROOT COLLECTIONS: Data attempts to be flat (proposals, clients) rather than nested, enforcing `tenantId` check on every read.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    /**
     * Check if user is authenticated
     */
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Check if authenticated user is the document owner
     */
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /**
     * Claims-based tenant source (trusted token claim)
     */
    function getAuthTenantId() {
      return isAuthenticated() ? request.auth.token.get('tenantId', '') : '';
    }

    /**
     * Claims-based role source (trusted token claim)
     */
    function getAuthRole() {
      return isAuthenticated() ? request.auth.token.get('role', '') : '';
    }

    /**
     * User-document tenant fallback for cases where custom claims are stale.
     */
    function getUserDocTenantId() {
      return isAuthenticated()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             ? get(/databases/$(database)/documents/users/$(request.auth.uid))
                 .data.get('tenantId',
                           get(/databases/$(database)/documents/users/$(request.auth.uid))
                             .data.get('companyId', ''))
             : '';
    }

    /**
     * Effective tenant source: prefer trusted claim, fallback to user document.
     */
    function getEffectiveTenantId() {
      let claimTenantId = getAuthTenantId();
      return claimTenantId != '' ? claimTenantId : getUserDocTenantId();
    }

    /**
     * User-document role fallback for stale claims.
     */
    function getUserDocRole() {
      return isAuthenticated()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             ? get(/databases/$(database)/documents/users/$(request.auth.uid))
                 .data.get('role', '')
             : '';
    }

    /**
     * Firestore role fallback for superadmin checks.
     * This avoids hard failures when production tokens are temporarily stale
     * while still requiring an authenticated, server-controlled user document.
     *
     * Tests pre-seed users/{uid} in beforeEach so exists() always finds the
     * doc; in production users/{uid} is created on signup.
     */
    function hasSuperAdminRoleInUserDoc() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
           .data.get('role', '') in ['superadmin', 'SUPERADMIN'];
    }

    /**
     * Claims-based master source (trusted token claim)
     */
    function getAuthMasterId() {
      return isAuthenticated() ? request.auth.token.get('masterId', '') : '';
    }

    /**
     * Bootstrap tenant used during initial registration before claims are minted.
     */
    function isBootstrapTenant(tenantId) {
      return isAuthenticated() && tenantId == 'tenant_' + request.auth.uid;
    }

    /**
     * Check if the user belongs to the tenant that owns the resource.
     */
    function belongsToTenant(resourceTenantId) {
       return isAuthenticated()
            && getEffectiveTenantId() != ''
              && resourceTenantId != ''
            && getEffectiveTenantId() == resourceTenantId
            && whatsappMfaSatisfied();
    }

    /**
     * 2FA por WhatsApp: quem o tem ativo só lê dado da empresa num login que
     * passou pelo código. Sem isto, a senha sozinha rendia um ID token (pela
     * API pública do Firebase) e o SDK lia tudo direto daqui, contornando o
     * segundo fator que só era conferido ao criar o cookie do site.
     *
     * A prova é `mfa_sessions/{uid}_{auth_time}`, gravada pelo backend quando o
     * código (ou um código de recuperação) é aceito; `auth_time` identifica o
     * login e sobrevive à renovação do token. TOTP nativo e os tokens de
     * recuperação (`recovery_login`, `whatsapp_login`) também satisfazem. Mesma
     * regra do backend: `apps/functions/src/lib/whatsapp-mfa-session.ts`.
     *
     * O próprio `users/{uid}` fica fora (é `isOwner`): a tela de login o lê
     * antes de o código ser digitado.
     */
    function whatsappMfaSatisfied() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let sessionPath = /databases/$(database)/documents/mfa_sessions/$(request.auth.uid + '_' + string(request.auth.token.auth_time));
      return !exists(userPath)
             || get(userPath).data.get('whatsappMfaEnabled', false) != true
             || !(get(userPath).data.get('whatsappMfaPhone', '') is string)
             || get(userPath).data.get('whatsappMfaPhone', '') == ''
             || request.auth.token.firebase.get('sign_in_second_factor', null) != null
             || request.auth.token.get('recovery_login', false) == true
             || request.auth.token.get('whatsapp_login', false) == true
             || (exists(sessionPath) && get(sessionPath).data.expiresAt > request.time);
    }

    /**
     * Tenant admin roles allowed to manage tenant-scoped records.
     */
    function hasTenantAdminRole() {
      return isAuthenticated()
             && (
               getAuthRole() in ['admin', 'ADMIN', 'master', 'MASTER', 'wk', 'WK']
               || getUserDocRole() in ['admin', 'ADMIN', 'master', 'MASTER', 'wk', 'WK']
             );
    }

    /**
     * Resolve tenant from resource data with legacy companyId fallback.
     */
    function tenantFromData(data) {
      return data.get('tenantId', data.get('companyId', ''));
    }

    /**
     * Self-registration user document validation.
     */
    function isValidSelfRegistrationUserCreate(userId) {
      let bootstrapTenant = 'tenant_' + request.auth.uid;
      return isOwner(userId)
             && request.resource.data.keys().hasOnly([
               'name',
               'email',
               'photoUrl',
               'phoneNumber',
               'role',
               'tenantId',
               'companyId',
               'onboarding',
               'createdAt',
               'updatedAt',
             ])
             && request.resource.data.get('role', '') in ['free', 'FREE']
             && request.resource.data.get('tenantId', '') == bootstrapTenant
             && request.resource.data.get('companyId', bootstrapTenant) == bootstrapTenant;
    }

    /**
     * True when the caller authenticated with a second factor (TOTP MFA).
     * Firebase sets firebase.sign_in_second_factor on the ID token after an
     * MFA sign-in; it is null for single-factor sessions.
     */
    function hasMfa() {
      return isAuthenticated()
             && (request.auth.token.firebase.sign_in_second_factor != null
                 // LOCAL DEV ONLY: the `dev_mfa_bypass` custom-token claim is
                 // minted exclusively by POST /v1/auth/dev-mfa-bypass, which is
                 // hard-gated to the `erp-softcode` dev project + localhost. Prod
                 // sessions can never carry it, so this does not weaken prod.
                 || request.auth.token.get('dev_mfa_bypass', false) == true);
    }

    /**
     * Check if user is a super admin.
     * Super admins have full read access to all tenant data for administration.
     * MFA (second factor) is REQUIRED — a super admin without an MFA session
     * loses client-SDK privileged access (data flows go through the backend
     * Admin SDK). This is intentional hardening; see SUPERADMIN_MFA_REQUIRED.
     */
    function isSuperAdmin() {
      return isAuthenticated()
             && hasMfa()
             && (getAuthRole() in ['superadmin', 'SUPERADMIN']
                 || hasSuperAdminRoleInUserDoc());
    }

    /**
     * Returns the subscriptionStatus claim from the token, or '' if absent.
     * Returns '' (not blocked) when the claim hasn't been set yet (backwards compat
     * during claim migration rollout — tokens without this claim are treated as active).
     */
    function getAuthSubscriptionStatus() {
      return isAuthenticated() ? request.auth.token.get('subscriptionStatus', '') : '';
    }

    /**
     * Returns true when the tenant's subscription allows data reads.
     *
     * Fast-path: active/trialing/free claims are trusted from the JWT (updated
     * within seconds by billing-claims.ts) — no Firestore read needed.
     * For ambiguous states (claim absent or 'past_due'), reads the authoritative
     * tenant document to catch stale-claim discrepancies (e.g., claim says
     * past_due but Firestore already shows canceled after an immediate cancel).
     *
     * tenants/{id} and users/{id} are intentionally excluded from this check
     * so the subscription-blocked page can still read billing state.
     */
    function tenantSubscriptionAllowsRead(resourceTenantId) {
      let claimStatus = getAuthSubscriptionStatus();
      let isAllowedClaim = claimStatus == 'active' || claimStatus == 'trialing' || claimStatus == 'free';
      let isBlockedClaim = claimStatus in ['canceled', 'cancelled', 'unpaid', 'inactive', 'payment_failed'];
      // isAllowedClaim/isBlockedClaim: pure string comparisons, safe as let bindings.
      // get() is placed inside an exists() && ... chain: && short-circuits reliably,
      // so get() is never evaluated on a non-existent document even if || does not
      // short-circuit (emulator v1.21+ does not short-circuit || consistently).
      return !(getAuthRole() in ['free', 'FREE'])
             && (isAllowedClaim
                 || (!isBlockedClaim
                     && isAuthenticated()
                     && resourceTenantId != ''
                     && (!exists(/databases/$(database)/documents/tenants/$(resourceTenantId))
                         || (exists(/databases/$(database)/documents/tenants/$(resourceTenantId))
                             && !(string(get(/databases/$(database)/documents/tenants/$(resourceTenantId)).data.get('subscriptionStatus', '')).lower()
                                  in ['canceled', 'cancelled', 'unpaid', 'inactive', 'payment_failed'])))));
    }

    /**
     * Read access to the shared read-only demo dataset. Any authenticated user
     * (incl. free-tier / demo accounts, which tenantSubscriptionAllowsRead
     * blocks) may READ documents tagged with the fixed 'demo' tenant.
     * Writes stay denied everywhere (Admin SDK seed only). Placed FIRST in the
     * read `||` chain so this cheap field comparison short-circuits before the
     * expensive tenantSubscriptionAllowsRead get()/exists() lookups.
     */
    // Ids de nicho aceitos. Lista espelhada de NICHE_REGISTRY
    // (apps/functions/src/shared/niches.ts), comparada em
    // apps/web/src/__tests__/niche-registry-parity.test.ts.
    function isKnownTenantNiche(niche) {
      return niche in ['automacao_residencial', 'cortinas', 'seguranca_eletronica', 'vidracaria_esquadrias', 'marcenaria', 'climatizacao'];
    }

    // O nicho (e o campo legado tenantNiche) de uma empresa nao muda depois
    // de gravado. Campo ausente conta como null dos dois lados.
    function tenantNicheUnchanged() {
      return request.resource.data.get('niche', null) == resource.data.get('niche', null)
             && request.resource.data.get('tenantNiche', null) == resource.data.get('tenantNiche', null);
    }

    // Tenants de demonstracao, um por nicho (demoTenantId de NICHE_REGISTRY),
    // comparados em apps/web/src/__tests__/niche-registry-parity.test.ts.
    function isDemoRead(resourceTenantId) {
      return isAuthenticated() && resourceTenantId in ['demo', 'demo-cortinas', 'demo-seguranca', 'demo-vidracaria', 'demo-marcenaria', 'demo-climatizacao'];
    }

    /**
     * Whitelist for allowing specific field updates.
     */
    function onlyUpdatesFields(allowedFields) {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(allowedFields);
    }

    // ============================================
    // USERS COLLECTION
    // ============================================

    match /users/{userId} {
      // READ: Own profile, Master of this user, Admin of same tenant, Member reading their Master, or Super Admin
      // Using resource.data.get() with default to avoid null errors for non-existent docs
      allow read: if isOwner(userId)
                  || isSuperAdmin()
                  || (isAuthenticated() && resource.data.get('masterId', '') == request.auth.uid)
                  || (hasTenantAdminRole() && belongsToTenant(tenantFromData(resource.data)))
                  || (isAuthenticated() && getAuthMasterId() == userId);

      // CREATE: Allowed for self-registration (user creating their own document)
      allow create: if isValidSelfRegistrationUserCreate(userId);

      // UPDATE: Owner can update profile info, but NOT sensitive roles/ids.
      // Super admin can update any field for tenant management.
      allow update: if isSuperAdmin()
                    || (isOwner(userId)
                        && onlyUpdatesFields(['name', 'photoUrl', 'phoneNumber', 'updatedAt'])
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['role', 'masterId', 'tenantId', 'companyId',
                                     'subscription', 'usage', 'stripeCustomerId', 'stripeSubscriptionId']));

      // DELETE: Blocked for regular users. Super admin can delete for tenant cleanup.
      allow delete: if isSuperAdmin();

      // PERMISSIONS SUBCOLLECTION: User can read their own permissions, their Master can, or Super Admin
      match /permissions/{permissionId} {
        allow read: if isOwner(userId)
                    || (isAuthenticated() && get(/databases/$(database)/documents/users/$(userId)).data.get('masterId', '') == request.auth.uid)
                    || isSuperAdmin();
        allow write: if false; // Only Cloud Functions can manage permissions
      }
    }

    // ============================================
    // TENANT RESOURCES (Root Collections)
    // ============================================
    // Pattern: Read allowed if user's tenantId matches resource's tenantId AND
    //          their subscription is not in a terminal blocked status.
    // Writes blocked (Cloud Functions only) or restricted.

    // PROPOSALS
    //
    // A proposta carrega os valores da venda, entao ser da empresa nao basta:
    // o membro precisa de "Ver" (users/{uid}/permissions/{pageId}, o doc que a
    // tela de Equipe grava) numa das telas que mostram a proposta inteira:
    // Propostas ou o CRM (o quadro exibe cada proposta com o valor). Dono e
    // administradores leem tudo. Sem isso o tecnico de campo, que so tem OS,
    // equipamentos e agenda, lia todos os precos pelo SDK.
    //
    // Telas de membro que precisam de algo da proposta sem os valores passam
    // pela API: a checagem de "em uso" antes de excluir contato, produto ou
    // servico (GET /v1/proposals/usage) e os aparelhos da obra
    // (GET /v1/projects/:id/proposal-equipment).
    function memberCanViewPage(pageId) {
      let permissionPath = /databases/$(database)/documents/users/$(request.auth.uid)/permissions/$(pageId);
      return exists(permissionPath) && get(permissionPath).data.get('canView', false) == true;
    }

    function canReadTenantProposals() {
      return hasTenantAdminRole()
             || memberCanViewPage('proposals')
             || memberCanViewPage('kanban');
    }

    // "Só os meus" (o alcance do catálogo de permissões, campo `scope` no doc
    // da página): sem o doc, ou sem o campo, vale "all", o de sempre. Dono e
    // administradores veem tudo. Quem tem "own" lê só o registro em que é o
    // dono (`ownerField`), e a consulta dele precisa trazer esse filtro: regra
    // não é filtro, e a lista sem o `where` é recusada inteira.
    function memberScopeOf(pageId) {
      let permissionPath = /databases/$(database)/documents/users/$(request.auth.uid)/permissions/$(pageId);
      return exists(permissionPath) ? get(permissionPath).data.get('scope', 'all') : 'all';
    }

    function memberSeesAll(pageId) {
      return hasTenantAdminRole() || memberScopeOf(pageId) == 'all';
    }

    function memberOwns(ownerField) {
      return resource.data.get(ownerField, '') == request.auth.uid;
    }

    match /proposals/{proposalId} {
      allow read: if isSuperAdmin()
                  || isDemoRead(resource.data.tenantId)
                  || (isAuthenticated()
                      && belongsToTenant(resource.data.tenantId)
                      && tenantSubscriptionAllowsRead(resource.data.tenantId)
                      && canReadTenantProposals()
                      && (memberSeesAll('proposals') || memberOwns('sellerId')));
      allow write: if false; // Managed by Cloud Functions (limits, validation)
      allow delete: if isSuperAdmin(); // Super admin can delete for tenant cleanup
    }

    // CLIENTS
    match /clients/{clientId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId) && (memberSeesAll('clients') || memberOwns('responsibleMemberId')));
      allow write: if false; // Managed by Cloud Functions (limits)
      allow delete: if isSuperAdmin(); // Super admin can delete for tenant cleanup
    }

    // PRODUCTS
    match /products/{productId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false; // Managed by Cloud Functions (limits)
      allow delete: if isSuperAdmin(); // Super admin can delete for tenant cleanup
    }

    // SERVICES
    match /services/{serviceId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false; // Managed by Cloud Functions (limits)
      allow delete: if isSuperAdmin(); // Super admin can delete for tenant cleanup
    }

    // PRICE TABLES (tabelas de preço específicas; a padrão é o catálogo).
    // Escrita só pelo backend (price-tables.controller), que aplica a
    // permissão de Produtos e o plano (Pro e Enterprise).
    match /price_tables/{priceTableId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false; // Managed by Cloud Functions
    }

    // O financeiro (lançamentos, resumos de grupo, carteiras e o histórico
    // delas) exige "Ver" em Lançamentos ou em Carteiras, além de ser da
    // empresa. Até 2026-10 bastava ser da empresa: o membro que só tinha o CRM
    // lia, pelo SDK, o aluguel e o saldo das carteiras. Quem vê Carteiras lê
    // também os lançamentos, porque o histórico da carteira os mostra.
    //
    // Telas de membro que precisam de algo do financeiro sem os valores passam
    // pela API: o seletor de carteira da proposta e do contrato
    // (GET /v1/wallets/options, só id e nome).
    function canReadTenantFinance() {
      return hasTenantAdminRole()
             || memberCanViewPage('transactions')
             || memberCanViewPage('wallet');
    }

    // Alcance de Lançamentos: "all" (o de sempre), "income" (só receitas) ou
    // "mine" (os das vendas dele: `sellerId`, copiado da proposta).
    function memberSeesTransaction() {
      let scope = hasTenantAdminRole() ? 'all' : memberScopeOf('transactions');
      return scope == 'all'
             || (scope == 'income' && resource.data.get('type', '') == 'income')
             || (scope == 'mine' && memberOwns('sellerId'));
    }

    // TRANSACTIONS (Financial)
    match /transactions/{transactionId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId) && canReadTenantFinance() && memberSeesTransaction());
      allow write: if false; // Managed by Cloud Functions (calculations)
    }

    // TRANSACTION GROUPS (resumos desnormalizados da aba Agrupados —
    // 1 doc por grupo, mantidos pelo trigger onTransactionTotals)
    // Agrupados soma lançamentos de todo alcance: só para quem vê tudo.
    match /transaction_groups/{groupDocId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId) && canReadTenantFinance() && memberSeesAll('transactions'));
      allow write: if false; // Admin SDK only (trigger)
    }

    // Controle de ordem dos resumos de grupo (readTime da leitura em que cada
    // resumo se baseou). Uso interno do trigger onTransactionTotals.
    match /transaction_group_sync/{groupDocId} {
      allow read, write: if false; // Admin SDK only
    }

    // Cursor de crons longos (lib/cron-iteration runRotatingCursor): onde a
    // execução anterior parou. Uso interno dos crons.
    match /cron_cursors/{cronId} {
      allow read, write: if false; // Admin SDK only
    }

    // WALLETS
    match /wallets/{walletId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId) && canReadTenantFinance());
      allow write: if false; // Managed by Cloud Functions
    }

    // WALLET TRANSACTIONS (audit log)
    match /wallet_transactions/{transactionId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId) && canReadTenantFinance());
      allow write: if false; // Managed by Cloud Functions
    }

    // WALLET CASCADE JOBS (live progress for async wallet rename cascade)
    // Tenant members may read their tenant's jobs so the UI can show
    // real-time progress via onSnapshot. Writes are Admin SDK only.
    match /wallet_cascade_jobs/{jobId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && belongsToTenant(resource.data.tenantId));
      allow write: if false; // Managed by Cloud Functions trigger
    }

    // SISTEMAS (Automation)
    match /sistemas/{sistemaId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false;
    }

    // AMBIENTES (Automation)
    match /ambientes/{ambienteId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false;
    }

    // PROPOSAL TEMPLATES
    match /proposal_templates/{templateId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false;
    }

    // CUSTOM FIELDS
    match /custom_fields/{fieldId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false;
      allow delete: if isSuperAdmin(); // Super admin can delete for tenant cleanup
    }

    // CUSTOM OPTIONS (Legacy)
    match /custom_options/{optionId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false;
      allow delete: if isSuperAdmin(); // Super admin can delete for tenant cleanup
    }

    // OPTIONS (Dynamic Selects)
    match /options/{optionId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false;
      allow delete: if isSuperAdmin(); // Super admin can delete for tenant cleanup
    }

    // ADDONS
    match /addons/{addonId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false; // Managed by Stripe Webhooks
    }

    // KANBAN STATUSES (Custom kanban columns per tenant)
    // Anotações da ficha do contato. Escritas só pelo backend
    // (client-notes.controller), que aplica a permissão de contatos.
    match /client_notes/{noteId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false; // Managed by Cloud Functions
    }

    // Leads e atividades do CRM (Onda 2): leitura direta pelo client, como o
    // resto do CRM; escrita so pela API (permissao kanban + capacidade crm).
    match /leads/{leadId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId) && (memberSeesAll('kanban') || memberOwns('ownerId')));
      allow write: if false; // Managed by Cloud Functions
    }

    match /activities/{activityId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false; // Managed by Cloud Functions
    }

    // Projetos de instalação (Onda 3): leitura direta pelo client, como o CRM;
    // escrita só pela API (permissão projects + capacidade projects).
    match /projects/{projectId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId) && (memberSeesAll('projects') || memberOwns('assigneeId')));
      allow write: if false; // Managed by Cloud Functions
    }

    // ASSISTÊNCIA TÉCNICA (capacidade fieldService). Leitura direta pelo
    // client, escrita só pela API (field-service.controller.ts).
    //
    // A OS é do técnico: lê quem está em `technicianUids`, o dono e os
    // administradores, e o membro com a permissão de escopo
    // `service_orders_all` (users/{uid}/permissions/service_orders_all). A
    // lista do técnico filtra por tenantId e technicianUids (array-contains),
    // que é o que deixa a regra ser provada; a de quem vê tudo, só por tenantId.
    function seesAllServiceOrders() {
      let permissionPath = /databases/$(database)/documents/users/$(request.auth.uid)/permissions/service_orders_all;
      return exists(permissionPath) && get(permissionPath).data.get('canView', false) == true;
    }

    match /service_orders/{orderId} {
      allow read: if isSuperAdmin()
                  || isDemoRead(resource.data.tenantId)
                  || (isAuthenticated()
                      && belongsToTenant(resource.data.tenantId)
                      && tenantSubscriptionAllowsRead(resource.data.tenantId)
                      && (hasTenantAdminRole()
                          || request.auth.uid in resource.data.get('technicianUids', [])
                          || seesAllServiceOrders()));
      allow write: if false;
    }

    // Equipamentos do cliente: da empresa inteira, como os projetos.
    match /customer_equipment/{equipmentId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false;
    }

    // Contratos de manutenção: da empresa inteira, como os equipamentos. A
    // mensalidade e a visita preventiva são gravadas pela rotina diária.
    match /service_contracts/{contractId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false;
    }

    // Responsáveis técnicos do PMOC (CREA/CFT, ART). A empresa lê (o contrato
    // PMOC escolhe um); escrita só pelo backend, que confere dono ou admin.
    match /technical_responsibles/{responsibleId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false;
    }

    // Link público do PMOC (o id é o token). Admin SDK only.
    match /shared_pmoc/{token} {
      allow read, write: if false;
    }

    // Trava da nota da mensalidade (uma por lançamento). Admin SDK only.
    match /contract_invoice_claims/{transactionId} {
      allow read, write: if false;
    }

    // Histórico de estoque: gravado só pelo backend, na mesma transação que
    // ajusta o saldo do produto.
    match /stock_movements/{movementId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false;
    }

    match /service_order_counters/{tenantId} {
      allow read, write: if false; // Admin SDK only
    }

    // Link público da OS: o id é o token, resolvido só pelo backend.
    match /shared_service_orders/{token} {
      allow read, write: if false;
    }

    match /project_settings/{tenantId} {
      allow read, write: if false; // Admin SDK only (lido pela API)
    }

    match /shared_projects/{shareId} {
      allow read, write: if false; // Link público só via backend
    }

    match /kanban_statuses/{statusId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.tenantId) || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false; // Managed by Cloud Functions
    }

    // CALENDAR EVENTS — UM calendario do tenant, nao um por membro.
    //
    // A regra restringia o membro aos eventos de que ele era dono
    // (ownerUserId == uid), enquanto GET /v1/calendar/events sempre devolveu o
    // tenant inteiro. As duas camadas discordavam, e o modelo do produto e o
    // compartilhado: o master conecta a conta Google da empresa e todo membro
    // com acesso ao Calendario ve os mesmos dados, com o que um marca
    // aparecendo para os outros.
    //
    // Quem pode ver o Calendario e decidido pela permissao "calendar" na tela
    // de Equipe, que a API cobra; aqui a regra e a mesma das outras colecoes
    // do tenant. Escrita segue exclusiva das Cloud Functions.
    // A Agenda (inclusive o que veio do Google: título, descrição, local)
    // exige "Ver" na Agenda. A tela lê pela API; ninguém precisa do SDK aqui.
    match /calendar_events/{eventId} {
      allow read: if isSuperAdmin()
                  || (isAuthenticated()
                      && belongsToTenant(resource.data.tenantId)
                      && tenantSubscriptionAllowsRead(resource.data.tenantId)
                      && (hasTenantAdminRole() || memberCanViewPage('calendar')));
      allow write: if false; // Managed by Cloud Functions
    }

    // ============================================
    // SYSTEM COLLECTIONS
    // ============================================

    // COMPANIES (Legacy/Core Tenant Info)
    // Not subscription-gated: needed by the subscription-blocked page to read billing context.
    match /companies/{companyId} {
      // Only members of the company can view its details
      allow read: if isSuperAdmin()
                  || (isAuthenticated()
                      && (companyId == getEffectiveTenantId()
                          || companyId == request.auth.token.get('companyId', '')));
      allow write: if false;
    }

    // TENANTS (New Tenant Info)
    // Not subscription-gated: needed by the subscription-blocked page to read billing/subscription state.
    match /tenants/{tenantId} {
      // Allow read if: super admin, user's tenantId matches, OR tenant ID matches the UID pattern (fallback for new users)
      allow read: if isSuperAdmin()
                  || belongsToTenant(tenantId)
                  || isBootstrapTenant(tenantId);
      // CREATE: Super admin can create any tenant, users can only create their own (self-registration).
      // Nos dois casos a empresa nasce com um nicho que existe.
      allow create: if (isSuperAdmin() && isKnownTenantNiche(request.resource.data.get('niche', '')))
                    || (isBootstrapTenant(tenantId)
                        && request.resource.data.get('tenantId', tenantId) == tenantId
                        && request.resource.data.keys().hasOnly([
                          'tenantId',
                          'name',
                          'slug',
                          'primaryColor',
                          'logoUrl',
                          'niche',
                          'createdAt',
                          'updatedAt',
                        ])
                        && isKnownTenantNiche(request.resource.data.get('niche', '')));
      // UPDATE: Super admin can update any field but the niche; tenant owner (master) can update safe fields.
      // O nicho nunca muda depois do cadastro, nem pelo superadmin: a empresa
      // inteira (catalogo, proposta, obra, demonstracao) segue o formato dele.
      allow update: if (isSuperAdmin() && tenantNicheUnchanged())
                    || (isAuthenticated()
                        && belongsToTenant(tenantId)
                        && hasTenantAdminRole()
                        && request.resource.data.get('tenantId', tenantId) == tenantId
                        && resource.data.get('tenantId', tenantId) == request.resource.data.get('tenantId', tenantId)
                        && onlyUpdatesFields(['name', 'primaryColor', 'logoUrl', 'updatedAt']));
      // DELETE: Only super admin can delete tenants
      allow delete: if isSuperAdmin();

      // MP OAuth one-time codes — written only by Admin SDK (backend)
      match /mpOAuthCodes/{codeHash} {
        allow read, write: if false;
      }
    }

    // PURCHASED ADDONS
    match /purchased_addons/{addonId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && belongsToTenant(resource.data.tenantId) && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false; // Managed by Stripe Webhooks
    }

    // PLANS (Public/Reference - needed by PlanService.getPlanById on frontend)
    match /plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // PAGES (Reference)
    match /pages/{pageId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // SHARED PROPOSALS - Acesso público via token
    // Cloud Functions validam token e expiração
    match /shared_proposals/{shareId} {
      allow read: if false; // Public access only via backend token-validation endpoint
      allow write: if false; // Apenas Cloud Functions
    }

    // SPREADSHEETS
    match /spreadsheets/{spreadsheetId} {
      allow read: if isSuperAdmin() || isDemoRead(resource.data.get('tenantId', '')) || (isAuthenticated() && belongsToTenant(resource.data.get('tenantId', '')) && tenantSubscriptionAllowsRead(resource.data.get('tenantId', '')) && (memberSeesAll('spreadsheets') || memberOwns('createdById')));
      // Criacao so pelo backend (POST /v1/spreadsheets), que aplica o teto de
      // planilhas do plano. As rules nao conhecem plano: com create aberto ao
      // client, o limite se contornava com uma escrita direta.
      allow create: if false;
      allow update: if isSuperAdmin()
                    || (isAuthenticated()
                        && hasTenantAdminRole()
                        && belongsToTenant(resource.data.get('tenantId', ''))
                        && request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '')
              && request.resource.data.get('tenantId', '') == getEffectiveTenantId());
      allow delete: if isSuperAdmin()
                    || (isAuthenticated()
                        && hasTenantAdminRole()
                        && belongsToTenant(resource.data.get('tenantId', '')));
    }

    // BOOKING - Link de agendamento: expediente, pedidos e a trava por dia.
    // Tudo pelo backend (o link público resolve a empresa pelo token, e os
    // pedidos chegam à tela pela API, com a permissão da Agenda).
    match /booking_settings/{tenantId} {
      allow read, write: if false;
    }
    match /booking_requests/{requestId} {
      allow read, write: if false;
    }
    match /booking_locks/{lockId} {
      allow read, write: if false;
    }

    // CLIENT_PORTAL_LINKS - Link do portal do cliente, um por contato. O token
    // abre propostas, pagamentos e obra do contato sem login, então nem a
    // própria empresa o lê pelo SDK: tudo passa pela API, com a permissão de
    // Contatos.
    match /client_portal_links/{linkId} {
      allow read, write: if false;
    }

    // TRANSACTION_CATEGORIES - Lista de categorias de lançamento da empresa,
    // cada uma num grupo do DRE (um doc por tenant). A tela lê e grava pela
    // API, com a permissão de Lançamentos; o DRE é montado no backend.
    match /transaction_categories/{tenantId} {
      allow read, write: if false;
    }

    // ACCOUNTANT_LINKS - Link do contador, um por empresa. O token abre o
    // financeiro e as notas da empresa sem login: ninguém o lê pelo SDK, nem
    // o dono (a tela usa a API, só para dono e administradores).
    match /accountant_links/{tenantId} {
      allow read, write: if false;
    }

    // SALES_GOALS - Metas de vendas por mês: lidas e gravadas só pelo backend,
    // que decide quem vê o quê (o membro recebe só o próprio número).
    match /sales_goals/{goalId} {
      allow read, write: if false;
    }

    // TASKS - Tarefa é da pessoa: lê quem criou, o responsável e quem foi
    // citado (`audienceUids`); dono e administradores leem todas. A lista do
    // membro filtra por tenantId e audienceUids (array-contains), que é o que
    // deixa a regra ser provada; a do administrador, só por tenantId.
    // Escrita só pelo backend (tasks.controller.ts).
    match /tasks/{taskId} {
      allow read: if isSuperAdmin()
                  || isDemoRead(resource.data.tenantId)
                  || (isAuthenticated()
                      && belongsToTenant(resource.data.tenantId)
                      && tenantSubscriptionAllowsRead(resource.data.tenantId)
                      && (hasTenantAdminRole()
                          || request.auth.uid in resource.data.get('audienceUids', [])));
      allow write: if false;
    }

    // NOTIFICATIONS - Cada pessoa lê só o que foi endereçado a ela
    // (`recipientUids`, resolvido na criação pelo catálogo, pelas permissões e
    // pelas preferências de cada um). Antes valia para a empresa inteira, e um
    // membro sem acesso ao financeiro lia "pagamento recebido" direto daqui.
    // A consulta do sino filtra por tenantId e por recipientUids (array-contains),
    // que é o que deixa esta regra ser provada para uma lista.
    // O tenant de demonstração (`demo`) é lido pela conta free, só leitura.
    match /notifications/{notificationId} {
      allow read: if isSuperAdmin()
                  || isDemoRead(resource.data.tenantId)
                  || (isAuthenticated()
                      && request.auth.uid in resource.data.get('recipientUids', [])
                      && belongsToTenant(resource.data.tenantId)
                      && tenantSubscriptionAllowsRead(resource.data.tenantId));
      allow write: if false; // Apenas Cloud Functions
    }

    // ============================================
    // AI ASSISTANT (Lia)
    // ============================================

    // AI Usage — monthly counters per tenant
    // Read: authenticated tenant members can see their usage; superadmin has read-only access
    // Write: only backend (Admin SDK) — incremented atomically by usage-tracker.ts
    match /tenants/{tenantId}/aiUsage/{month} {
      allow read: if isSuperAdmin() || (isAuthenticated() && belongsToTenant(tenantId) && tenantSubscriptionAllowsRead(tenantId));
      allow write: if false;
    }

    // AI Conversations — chat history per session
    // get: user can only fetch their own session doc (uid enforced on resource); superadmin can read any
    // list: tenant-scoped only; client query must include where("uid","==",uid) for user isolation
    // Write: only backend (Admin SDK) — managed by conversation-store.ts
    match /tenants/{tenantId}/aiConversations/{sessionId} {
      allow get: if isSuperAdmin()
                 || (isAuthenticated()
                     && belongsToTenant(tenantId)
                     && tenantSubscriptionAllowsRead(tenantId)
                     && (resource == null || resource.data.uid == request.auth.uid));
      // list: require uid equality on every returned document so a query without
      // a uid filter (or one with another user's uid) is automatically rejected.
      allow list: if isSuperAdmin()
                  || (isAuthenticated()
                      && belongsToTenant(tenantId)
                      && tenantSubscriptionAllowsRead(tenantId)
                      && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // ============================================
    // BACKEND-ONLY COLLECTIONS
    // Managed exclusively by Cloud Functions (admin SDK).
    // Explicitly denied to prevent accidental client access.
    // ============================================

    match /phoneNumberIndex/{phone} {
      allow read, write: if false;
    }

    match /whatsappUsage/{tenantId} {
      allow read, write: if false;
      match /months/{month} {
        allow read, write: if false;
      }
    }

    match /whatsappSessions/{sessionId} {
      allow read, write: if false;
    }

    match /whatsappRateLimit/{limitId} {
      allow read, write: if false;
    }

    match /whatsappLogs/{logId} {
      allow read, write: if false;
    }

    match /stripe_events/{eventId} {
      allow read, write: if false;
    }

    match /payout_attempts/{id} {
      allow read, write: if false; // backend-only via Admin SDK
    }

    // EMAIL AUDIT — written exclusively by Cloud Functions (Admin SDK)
    // Super admins can read for operational monitoring; no tenant-level access needed
    match /email_audit/{auditId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /calendar_integrations/{integrationId} {
      allow read, write: if false;
    }

    match /calendar_oauth_states/{stateId} {
      allow read, write: if false;
    }

    // Integracao com o Google Drive. Mesmo molde de calendar_integrations, pelo
    // mesmo motivo: o documento guarda um refresh token do Google cifrado em
    // KMS. Nem leitura pelo client — o tenant consulta o estado da conexao pela
    // API (`GET /v1/drive/google/status`), que devolve so e-mail conectado e
    // nome da pasta, nunca o token.
    match /google_drive_integrations/{tenantId} {
      allow read, write: if false;
    }

    match /drive_oauth_states/{stateId} {
      allow read, write: if false;
    }

    // Fila de entrega da proposta no Drive. Trabalho interno do backend: o
    // salvamento enfileira e um cron entrega, para o Chromium sair da request
    // do usuario. Nada aqui e de consumo do client.
    match /drive_delivery_jobs/{jobId} {
      allow read, write: if false;
    }

    // Configuracao e CONTADOR da numeracao de proposta (o codigo tipo
    // 0018926SP). Escrita so pelo Admin SDK: um contador que o client
    // pudesse gravar deixaria duas propostas nascerem com o mesmo
    // identificador. A leitura passa pelo backend
    // (GET /v1/proposals/numbering), que e quem decide quem pode ver.
    match /proposal_counters/{tenantId} {
      allow read, write: if false;
    }

    // Configuracao fiscal do emitente (CNPJ, IE/IM, regime, serie/numeracao e a
    // senha do certificado A1 cifrada em KMS). Colecao propria, e nao um map em
    // tenants/{id}, porque aquele doc e legivel por qualquer membro do tenant e
    // o Firestore nao tem regra por campo. Todo acesso passa pelo Admin SDK.
    match /fiscal_settings/{tenantId} {
      allow read, write: if false;
    }

    // Notas fiscais emitidas. Diferente de fiscal_settings, o tenant PODE ler:
    // a UI acompanha a autorizacao por onSnapshot e nao ha segredo aqui — so
    // dados do proprio documento fiscal. Escrita e exclusiva das Cloud Functions
    // porque numeracao e status sao estado fiscal.
    // Notas de ENTRADA — emitidas contra o CNPJ do tenant. Mesmo molde de
    // invoices: o tenant le (a UI lista), so a Cloud Function escreve. A
    // manifestacao e ato formal perante a Receita e nao pode partir do client.
    // Notas (emitidas e de entrada) levam CPF/CNPJ e valores: exigem "Ver"
    // em Notas Fiscais. A tela lê pela API.
    match /received_invoices/{docId} {
      allow read: if isSuperAdmin()
                  || isDemoRead(resource.data.tenantId)
                  || (isAuthenticated()
                      && belongsToTenant(resource.data.tenantId)
                      && tenantSubscriptionAllowsRead(resource.data.tenantId)
                      && (hasTenantAdminRole() || memberCanViewPage('invoices')));
      allow write: if false;
    }

    // Cursor de sincronizacao — estado interno, sem valor para o client.
    match /received_invoice_cursors/{tenantId} {
      allow read, write: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if isSuperAdmin()
                  || isDemoRead(resource.data.tenantId)
                  || (isAuthenticated()
                      && belongsToTenant(resource.data.tenantId)
                      && tenantSubscriptionAllowsRead(resource.data.tenantId)
                      && (hasTenantAdminRole() || memberCanViewPage('invoices')));
      allow write: if false;
    }

    // SECURITY OBSERVABILITY — written exclusively by Cloud Functions (Admin SDK).
    // The audit trail is read through the backend (GET /admin/audit-events), never
    // via the client SDK. Denied here explicitly for clarity (also covered by the
    // catch-all below).
    match /security_audit_events/{eventId} {
      allow read, write: if false;
    }

    // ERROR OBSERVABILITY — written exclusively by Cloud Functions (Admin SDK).
    // Read is allowed ONLY to an MFA'd super admin (isSuperAdmin() already requires
    // hasMfa()), to power the live superadmin dashboard via onSnapshot. Client
    // writes are denied entirely — the ingest pipeline is server-side only.
    // Ultimo acesso da empresa (painel do superadmin). Fora do doc tenants/{id}
    // de proposito: aquele doc e escutado em tempo real por toda aba aberta da
    // empresa. Escrita e leitura so pelo backend (Admin SDK).
    match /tenant_presence/{tenantId} {
      allow read, write: if false;
    }

    // Atividade das empresas (telas, acoes, jornada e erros), lida so pelo
    // painel do super admin via API (GET /v1/admin/activity). Escrita so pelo
    // backend (POST /v1/activity/events e eventos do servidor).
    match /tenant_activity/{eventId} {
      allow read, write: if false;
    }

    // Armazenamento em uso (bytes + flag de estouro), mantido pelos gatilhos de
    // Storage. A empresa le para mostrar o uso na tela de assinatura e avisar
    // antes do upload; quem barra de fato e a storage.rules, que le a flag.
    // A subcolecao `events` (dedup de eventos) nao tem regra: DENY.
    match /tenant_storage_usage/{tenantId} {
      allow read: if isSuperAdmin()
                  || (isAuthenticated()
                      && belongsToTenant(tenantId)
                      && tenantSubscriptionAllowsRead(tenantId));
      allow write: if false;
    }

    // Exclusao definitiva de empresa (painel do superadmin). Escrita so pelo
    // backend; o superadmin le para acompanhar o progresso na tela.
    match /tenant_purge_jobs/{tenantId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /error_issues/{fingerprint} {
      allow read: if isSuperAdmin();
      allow write: if false;

      match /occurrences/{occurrenceId} {
        allow read: if isSuperAdmin();
        allow write: if false;
      }
      match /_agg/{aggId} {
        allow read: if isSuperAdmin();
        allow write: if false;
      }
    }

    match /error_metrics/{windowId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // AI TRACES — um doc por turno da Lia (ferramenta, latência, desfecho).
    // Escrito exclusivamente pelas Cloud Functions (Admin SDK). Leitura só para
    // super admin com MFA, como o resto da observabilidade. Não contém args de
    // ferramenta nem conteúdo de mensagem — ver apps/functions/src/ai/trace.ts.
    match /ai_traces/{traceId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /security_metrics/{windowId} {
      allow read, write: if false;
    }

    match /security_metrics_tenants/{docId} {
      allow read, write: if false;
    }

    // WhatsApp OTP 2FA challenges (hashed code + TTL + attempt counters).
    // Written and verified exclusively by Cloud Functions (Admin SDK).
    match /mfaOtpChallenges/{uid} {
      allow read, write: if false;
    }

    // MFA recovery (backup) codes — hashed, single-use. Written, read and
    // consumed exclusively by Cloud Functions (Admin SDK). Never client-visible.
    match /mfaRecoveryCodes/{uid} {
      allow read, write: if false;
    }

    // Logins que passaram pelo 2FA do WhatsApp (whatsappMfaSatisfied). Gravado
    // só pelo backend; um cliente que pudesse criar o próprio doc pularia o
    // segundo fator.
    match /mfa_sessions/{sessionId} {
      allow read, write: if false;
    }

    // Calendário público de reuniões (/agendar). Sem tenantId — coleção global.
    // Apenas o backend (Admin SDK) lê/escreve. Cliente nunca acessa.
    match /demo_bookings/{bookingId} {
      allow read, write: if false;
    }

    // ============================================
    // CATCH-ALL
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
