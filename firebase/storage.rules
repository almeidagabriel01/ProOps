rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Claims-based tenant source (trusted token claim)
    function getAuthTenantId() {
      return isAuthenticated() ? request.auth.token.get('tenantId', '') : '';
    }

    // Claims-based role source (trusted token claim)
    function getAuthRole() {
      return isAuthenticated() ? request.auth.token.get('role', '') : '';
    }

    // Fallback para claims velhas ou ausentes, no mesmo criterio do
    // firestore.rules (getUserDocTenantId/getUserDocRole) e do backend
    // (lib/auth-context.ts). Sem ele uma conta cujo doc ja e de admin, mas cuja
    // claim ficou vazia ou `free`, usava o ERP inteiro e so o upload de imagem
    // era negado. O doc e confiavel: o cliente so o cria como `free` no
    // proprio tenant e nao altera `role` nem `tenantId` depois.
    function userDocPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function getUserDocTenantId() {
      return firestore.exists(userDocPath())
             ? firestore.get(userDocPath()).data.get('tenantId',
                 firestore.get(userDocPath()).data.get('companyId', ''))
             : '';
    }

    function getUserDocRole() {
      return firestore.exists(userDocPath())
             ? firestore.get(userDocPath()).data.get('role', '')
             : '';
    }

    function getEffectiveTenantId() {
      let claimTenantId = getAuthTenantId();
      return claimTenantId != '' ? claimTenantId : getUserDocTenantId();
    }

    function isSuperAdmin() {
      return isAuthenticated() && getAuthRole() in ['superadmin', 'SUPERADMIN'];
    }

    function isAdminRole(role) {
      return role in ['admin', 'ADMIN', 'master', 'MASTER', 'wk', 'WK'];
    }

    function hasTenantWriteRole() {
      return isAuthenticated()
             && (isSuperAdmin()
                 || isAdminRole(getAuthRole())
                 || isAdminRole(getUserDocRole()));
    }

    // Membro grava imagem da pagina que ele pode criar ou editar
    // (users/{uid}/permissions/{pageId}, o mesmo doc que a tela de Equipe grava).
    // A pasta do Storage tem o nome do pageId: products, services, proposals.
    function isMemberRole(role) {
      return role in ['member', 'MEMBER'];
    }

    function memberCanWritePage(pageId) {
      let permissionPath = /databases/(default)/documents/users/$(request.auth.uid)/permissions/$(pageId);
      return isAuthenticated()
             && (isMemberRole(getAuthRole()) || isMemberRole(getUserDocRole()))
             && firestore.exists(permissionPath)
             && (firestore.get(permissionPath).data.get('canCreate', false) == true
                 || firestore.get(permissionPath).data.get('canEdit', false) == true);
    }

    function canWriteFolder(folder) {
      return hasTenantWriteRole() || memberCanWritePage(folder);
    }

    function belongsToTenant(tenantId) {
      return isAuthenticated()
             && getEffectiveTenantId() != ''
             && getEffectiveTenantId() == tenantId;
    }
    
    // Helper function to check image file size (5MB max)
    function isValidImageFileSize() {
      return request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024;
    }

    // Helper function to check attachment file size (10MB max)
    function isValidAttachmentFileSize() {
      return request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024;
    }
    
    // Helper function to allow only raster images (blocks SVG/script payloads)
    function isAllowedImageType() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|gif|webp|avif)');
    }

    function isAllowedImageFolder(folder) {
      return folder == 'products' || folder == 'proposals' || folder == 'services';
    }

    function isAllowedAttachmentType() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|gif|webp|avif)')
             || request.resource.contentType == 'application/pdf';
    }

    // Teto de armazenamento do plano. O upload vai do navegador direto para ca,
    // sem passar pelo backend, entao e aqui que ele e barrado. As rules nao
    // conhecem plano: quem calcula e o backend, que grava `overQuota` a cada
    // arquivo e a cada troca de plano. Sem doc = empresa sem arquivo contado.
    // Apagar continua liberado (regra `delete` propria), que e o caminho para
    // voltar ao teto.
    function storageQuotaAvailable(tenantId) {
      let usagePath = /databases/(default)/documents/tenant_storage_usage/$(tenantId);
      return isSuperAdmin()
             || !firestore.exists(usagePath)
             || firestore.get(usagePath).data.get('overQuota', false) != true;
    }

    function canReadTenantPath(tenantId) {
      return isSuperAdmin() || belongsToTenant(tenantId);
    }
    
    // Tenant images - organized by tenant ID
    // Path: tenants/{tenantId}/products/{productId}/{filename}
    // Path: tenants/{tenantId}/proposals/{proposalId}/{filename}
    match /tenants/{tenantId}/{folder}/{fileName} {
      allow read: if isAllowedImageFolder(folder) && canReadTenantPath(tenantId);
      allow write: if isAllowedImageFolder(folder)
                   && canReadTenantPath(tenantId)
                   && canWriteFolder(folder)
                   && isValidImageFileSize()
                   && isAllowedImageType()
                   && storageQuotaAvailable(tenantId);
      allow delete: if isAllowedImageFolder(folder)
                    && canReadTenantPath(tenantId)
                    && canWriteFolder(folder);
    }

    match /tenants/{tenantId}/{folder}/{entityId}/{fileName} {
      allow read: if isAllowedImageFolder(folder) && canReadTenantPath(tenantId);
      allow write: if isAllowedImageFolder(folder)
                   && canReadTenantPath(tenantId)
                   && canWriteFolder(folder)
                   && isValidImageFileSize()
                   && isAllowedImageType()
                   && storageQuotaAvailable(tenantId);
      allow delete: if isAllowedImageFolder(folder)
                    && canReadTenantPath(tenantId)
                    && canWriteFolder(folder);
    }

    // Proposal attachments:
    // tenants/{tenantId}/proposals/{proposalId}/attachments/{fileName}
    match /tenants/{tenantId}/proposals/{proposalId}/attachments/{fileName} {
      allow read: if canReadTenantPath(tenantId);
      allow write: if canReadTenantPath(tenantId)
                   && canWriteFolder('proposals')
                   && isValidAttachmentFileSize()
                   && isAllowedAttachmentType()
                   && storageQuotaAvailable(tenantId);
      allow delete: if canReadTenantPath(tenantId) && canWriteFolder('proposals');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
